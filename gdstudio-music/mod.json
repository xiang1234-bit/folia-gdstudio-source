{
  "folium": 2,
  "id": "gdstudio-music",
  "name": "GD 音乐台音源",
  "version": "1.2.2",
  "author": "xiang1234-bit",
  "description": "接入 GD 音乐台 (music.gdstudio.xyz) 公开接口的 Folium 2 第三方音源模组：支持网易云 / JOOX / Bilibili 等上游切换、搜歌、最高 Hi-Res 音质播放、封面按需加载、歌词获取，以及在首页「歌单」与「探索」页直接展示导入的 GD 音乐台歌单（支持网易云 UID、歌单 ID/链接、本地 JSON 备份与内置热门榜单）。仅供个人学习与研究使用，数据出处 music.gdstudio.xyz。",
  "repository": "https://github.com/xiang1234-bit/folia-gdstudio-source",
  "bugs": "https://github.com/xiang1234-bit/folia-gdstudio-source/issues",
  "client": "client.mjs",
  "main": "index.cjs",
  "locales": "locales",
  "sources": [
    {
      "id": "gdstudio",
      "name": {
        "zh-CN": "GD 音乐台",
        "en": "GD Music Studio"
      },
      "requires": [
        "search@1",
        "songs@1",
        "playback.audio@1",
        "lyrics@1",
        "auth@1",
        "library@1",
        "catalog@1",
        "explore@1"
      ]
    }
  ]
}
